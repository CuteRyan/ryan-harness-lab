{
  "env": {},
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(pip show:*)",
      "Bash(tasklist:*)"
    ],
    "additionalDirectories": [
      "<!-- 프로젝트별 추가 디렉토리 -->"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\rlgns\\.claude\\hooks\\pretooluse-guard.ps1\""
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest"
}
